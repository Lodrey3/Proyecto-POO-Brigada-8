digraph G { graph[fontname="DejaVu Sans",dpi=200,nodesep=0.5,ranksep=0.8]; node[shape=plaintext,fontname="DejaVu Sans",fontsize=11]; edge[fontname="DejaVu Sans",fontsize=9,arrowsize=0.9];
S[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F1ECFA"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5">«Fachada»<BR/><B>SistemaPaqueteria</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-tarifas: TablaTarifas</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-resolvedor: ResolvedorZona</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fabrica: FabricaEnvios</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-registro: RegistroEnvios</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-guias: GeneradorGuias</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-repartidores: list[Repartidor]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-repositorio: Repositorio</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-reloj: Reloj</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+cotizar(datos: dict): Cotizacion</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+registrar_envio(datos: dict): Envio</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+rastrear(guia: str): tuple[str, list[RegistroEstado]]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+obtener_envio(guia: str): Envio</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+cambiar_estado(guia: str, accion: str): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+cancelar_envio(guia: str): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+listar_envios(estado: str | None): list[Envio]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+repartidores(): list[Repartidor]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+agregar_repartidores(reps: list[Repartidor]): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+asignar_envios(): ResultadoAsignacion</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+importar_csv(ruta: str): ResultadoImportacion</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+generar_reporte(fecha: date, ruta: str): str</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+simular_jornada(ruta_bitacora, semilla, prob_fallo): ResumenJornada</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+guardar(): None</TD></TR></TABLE></TD></TR></TABLE>>];
Imp[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F1ECFA"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>ImportadorEnvios</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fabrica: FabricaEnvios</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+importar(ruta: str, fecha: datetime): ResultadoImportacion</TD></TR></TABLE></TD></TR></TABLE>>];
