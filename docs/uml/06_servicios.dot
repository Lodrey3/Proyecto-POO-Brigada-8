Gui[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F1ECFA"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>GeneradorGuias</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-contador: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-lock: Lock</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+contador: int  «propiedad»</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+siguiente(fecha: date): str  # PQ-AAAAMMDD-0001</TD></TR></TABLE></TD></TR></TABLE>>];
