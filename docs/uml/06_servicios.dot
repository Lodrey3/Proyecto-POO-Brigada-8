RI[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F3F3F3"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5">«value object»<BR/><B>ResultadoImportacion</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+aceptados: list[Envio]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+rechazados: list[RenglonRechazado]</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR></TABLE>>];
