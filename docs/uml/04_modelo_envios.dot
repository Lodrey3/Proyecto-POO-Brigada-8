digraph G { graph[fontname="DejaVu Sans",dpi=200,nodesep=0.5,ranksep=0.8]; node[shape=plaintext,fontname="DejaVu Sans",fontsize=11]; edge[fontname="DejaVu Sans",fontsize=9,arrowsize=0.9];
Envio[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF1FB"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B><I>Envio</I></B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-guia: str | None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-remitente: Contacto</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-destinatario: Contacto</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-zona: Zona</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-servicio: Servicio</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-estado: EstadoEnvio</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-historial: list[RegistroEstado]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-intentos_fallidos: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-repartidor_id: str | None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fecha_registro: datetime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-cotizacion: Cotizacion | None</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+validar(): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+cotizar(tarifas: TablaTarifas): Cotizacion</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+total(): float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>#costo_base(tarifas): float</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#validar_reglas(): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#recargo(base: float): float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#seguro(): float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+peso_para_carga(): float</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+tipo(): str</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+asignar_guia(guia: str): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+asignar_repartidor(repartidor_id: str | None): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ingresar_a_almacen(fecha): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+salir_a_ruta(fecha): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+entregar(fecha): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+registrar_intento_fallido(fecha): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+cancelar(fecha): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+historial(): tuple[RegistroEstado]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#cambiar_estado(nuevo, fecha, nota): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#incrementar_intentos(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+restaurar(guia, estado, historial, intentos, repartidor_id, cotizacion): None</TD></TR></TABLE></TD></TR></TABLE>>];
Sobre[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF1FB"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>Sobre</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+PESO_KG: float = 0.1</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">#costo_base(tarifas): float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+peso_para_carga(): float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+tipo(): str</TD></TR></TABLE></TD></TR></TABLE>>];
Paquete[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF1FB"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>Paquete</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-peso_kg: float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-dimensiones: Dimensiones</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-valor_declarado: float</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+peso_volumetrico(): float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+peso_cobrado(): float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#costo_base(tarifas): float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#validar_reglas(): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+peso_para_carga(): float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+tipo(): str</TD></TR></TABLE></TD></TR></TABLE>>];
Fragil[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF1FB"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>PaqueteFragil</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+RECARGO: float = 0.20</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+SEGURO: float = 0.03</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">#recargo(base: float): float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#seguro(): float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+tipo(): str</TD></TR></TABLE></TD></TR></TABLE>>];
Refri[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF1FB"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>PaqueteRefrigerado</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">#validar_reglas(): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+tipo(): str</TD></TR></TABLE></TD></TR></TABLE>>];
Dim[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F3F3F3"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5">«value object»<BR/><B>Dimensiones</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-largo_cm: float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-ancho_cm: float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-alto_cm: float</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+peso_volumetrico_kg(): float  # L×A×H/5000</TD></TR></TABLE></TD></TR></TABLE>>];
Contacto[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF1FB"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>Contacto</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-nombre: str</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-telefono: str</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-codigo_postal: str</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-direccion: Direccion | None</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+validar(rol: str): None</TD></TR></TABLE></TD></TR></TABLE>>];
Direccion[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF1FB"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>Direccion</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-calle: str</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-ciudad: str</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR></TABLE>>];
Reg[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F3F3F3"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5">«value object»<BR/><B>RegistroEstado</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+estado: str</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+fecha_hora: datetime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+nota: str</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR></TABLE>>];
Cot[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F3F3F3"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5">«value object»<BR/><B>Cotizacion</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+base: float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+recargo_fragil: float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+recargo_servicio: float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+seguro: float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+total: float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+dias_min: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+dias_max: int</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR></TABLE>>];
Zona[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F3F3F3"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5">«enumeration»<BR/><B>Zona</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">LOCAL</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">REGIONAL</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">NACIONAL</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+desde_texto(texto: str): Zona</TD></TR></TABLE></TD></TR></TABLE>>];
Estado[label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="6" BGCOLOR="#EEF6E8"><TR><TD><B><I>EstadoEnvio</I></B></TD></TR></TABLE>>];
Servicio[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF5D6"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B><I>Servicio</I></B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+nombre(): str</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+factor_precio(): float</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+dias_min(): int</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+dias_max(): int</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+es_express(): bool</TD></TR></TABLE></TD></TR></TABLE>>];
Est[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF1FB"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>ServicioEstandar</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+factor_precio(): float  # 1.0</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+dias_min() / dias_max()  # 3 y 5</TD></TR></TABLE></TD></TR></TABLE>>];
Exp[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF1FB"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>ServicioExpress</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+factor_precio(): float  # 1.5</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+dias_min() / dias_max()  # 1 y 1</TD></TR></TABLE></TD></TR></TABLE>>];
edge[dir=back,arrowtail=empty];
Envio->Sobre; Envio->Paquete; Paquete->Fragil; Paquete->Refri; Servicio->Est; Servicio->Exp;
edge[dir=back,arrowtail=diamond];
Envio->Contacto[taillabel="1",headlabel="2",label="remitente / destinatario"];
Envio->Reg[taillabel="1",headlabel="1..*",label="historial"];
Paquete->Dim[taillabel="1",headlabel="1"];
Contacto->Direccion[taillabel="1",headlabel="0..1"];
Envio->Cot[taillabel="1",headlabel="0..1",label="última cotización"];
edge[dir=forward,arrowhead=vee,arrowtail=none];
Envio->Zona[label="zona",taillabel="*"];
Envio->Estado[label="estado actual",taillabel="*"];
Envio->Servicio[label="servicio",taillabel="*",headlabel="1"];
Refri->Servicio[style=dashed,label="«consulta es_express()»"];
}