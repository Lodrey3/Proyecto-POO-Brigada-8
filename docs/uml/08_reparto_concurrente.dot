digraph G { graph[fontname="DejaVu Sans",dpi=200,nodesep=0.5,ranksep=0.8]; node[shape=plaintext,fontname="DejaVu Sans",fontsize=11]; edge[fontname="DejaVu Sans",fontsize=9,arrowsize=0.9];
Sim[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E4F4F4"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>SimuladorJornada</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-repartidores: list[Repartidor]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-central: CentralMonitoreo</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-reloj: Reloj</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-prob_fallo: float = 0.10</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-semilla: int | None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-pausa_max: float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-hilos: list[HiloRepartidor]</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ejecutar(): ResumenJornada</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-_verificar_consistencia(): None</TD></TR></TABLE></TD></TR></TABLE>>];
Hilo[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E4F4F4"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5">«Thread»<BR/><B>HiloRepartidor</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-repartidor: Repartidor</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-central: CentralMonitoreo</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-reloj: Reloj</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-prob_fallo: float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-azar: Random</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+bitacora: list[tuple[str, str]]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+errores: list[str]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+envios_atendidos: list[Envio]</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+run(): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-_atender(envio: Envio): bool</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-_fecha(): datetime</TD></TR></TABLE></TD></TR></TABLE>>];
Res[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F3F3F3"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5">«value object»<BR/><B>ResumenJornada</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+entregados: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+fallidos: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+devueltos: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+por_repartidor: dict[str, int]</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR></TABLE>>];
Rep[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF1FB"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>Repartidor</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: str</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-nombre: str</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-vehiculo: Vehiculo</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-envios: list[Envio]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-lock: RLock</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+envios(): list[Envio]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+carga_actual(): float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+capacidad_disponible(): float</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+puede_cargar(envio: Envio): bool</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+asignar(envio: Envio): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+retirar(envio: Envio): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+vaciar_ruta(): list[Envio]</TD></TR></TABLE></TD></TR></TABLE>>];
Cen[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E4F4F4"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5">«Subject»<BR/><B>CentralMonitoreo</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-observadores: list[Observador]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-cola: Queue</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-lock: Lock</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+suscribir(obs: Observador): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+publicar(evento: EventoAvance): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+drenar(): None</TD></TR></TABLE></TD></TR></TABLE>>];
Veh[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF5D6"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B><I>Vehiculo</I></B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+capacidad_kg(): float</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+tipo(): str</I></TD></TR></TABLE></TD></TR></TABLE>>];
Env[label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="6" BGCOLOR="#EAF1FB"><TR><TD><B><I>Envio</I></B></TD></TR></TABLE>>];
Obs[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF5D6"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5">«interface»<BR/><B><I>Observador</I></B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+actualizar(evento: EventoAvance): None</I></TD></TR></TABLE></TD></TR></TABLE>>];
Ev[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F3F3F3"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5">«value object»<BR/><B>EventoAvance</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+repartidor_id: str</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+guia: str</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+resultado: str</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+entregados: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+total: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+fecha_hora: datetime</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR></TABLE>>];
Mo[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF1FB"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>Motocicleta</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+capacidad_kg(): float  # 20</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+tipo(): str</TD></TR></TABLE></TD></TR></TABLE>>];
Ca[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF1FB"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>Camioneta</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+capacidad_kg(): float  # 500</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+tipo(): str</TD></TR></TABLE></TD></TR></TABLE>>];
Vi[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E4F4F4"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>VistaConsola</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-lock: Lock</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+actualizar(evento: EventoAvance): None</TD></TR></TABLE></TD></TR></TABLE>>];
Bi[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E4F4F4"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>BitacoraArchivo</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-ruta: str</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-lock: Lock</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+actualizar(evento: EventoAvance): None</TD></TR></TABLE></TD></TR></TABLE>>];
edge[dir=back,arrowtail=diamond]; Sim->Hilo[taillabel="1",headlabel="1..*"]; Rep->Veh[taillabel="1",headlabel="1"];
edge[dir=back,arrowtail=odiamond]; Rep->Env[taillabel="1",headlabel="0..*",label="envíos asignados"]; Cen->Obs[taillabel="1",headlabel="0..*",label="observadores"];
edge[dir=back,arrowtail=empty]; Veh->Mo; Veh->Ca;
edge[dir=back,arrowtail=empty,style=dashed]; Obs->Vi; Obs->Bi;
edge[dir=forward,arrowhead=vee,arrowtail=none,style=solid]; Hilo->Rep[label="atiende",taillabel="1",headlabel="1"]; Hilo->Cen[label="publica en",taillabel="*",headlabel="1"]; Sim->Cen[headlabel="1"];
edge[style=dashed]; Sim->Res[label="«crea»"]; Cen->Ev[label="«emite»"];
}