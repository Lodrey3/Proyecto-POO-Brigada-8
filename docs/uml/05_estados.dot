digraph G { graph[fontname="DejaVu Sans",dpi=200,nodesep=0.5,ranksep=0.8]; node[shape=plaintext,fontname="DejaVu Sans",fontsize=11]; edge[fontname="DejaVu Sans",fontsize=9,arrowsize=0.9];
Envio[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EAF1FB"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B><I>Envio</I></B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">-estado: EstadoEnvio</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-historial: list[RegistroEstado]</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-intentos_fallidos: int</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ingresar_a_almacen(fecha): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+salir_a_ruta(fecha): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+entregar(fecha): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+registrar_intento_fallido(fecha): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+cancelar(fecha): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#cambiar_estado(nuevo, fecha, nota): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#incrementar_intentos(): int</TD></TR></TABLE></TD></TR></TABLE>>];
E[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF5D6"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5">«abstract»<BR/><B><I>EstadoEnvio</I></B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+nombre: str</TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ingresar_a_almacen(envio, fecha): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+salir_a_ruta(envio, fecha): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+entregar(envio, fecha): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+registrar_intento_fallido(envio, fecha): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+cancelar(envio, fecha): None</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+es_final(): bool</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+desde_nombre(nombre: str): EstadoEnvio  {estático}</TD></TR></TABLE></TD></TR></TABLE>>];
R[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEF6E8"><TR><TD BORDER="1" SIDES="B" CELLPADDING="5"><B>EstadoRegistrado</B></TD></TR><TR><TD BORDER="1" SIDES="B"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD> </TD></TR></TABLE></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ingresar_a_almacen(envio, fecha)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+cancelar(envio, fecha)</TD></TR></TABLE></TD></TR></TABLE>>];
